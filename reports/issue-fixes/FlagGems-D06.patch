+
+
+@pytest.mark.skipif(
+    flag_gems.vendor_name != "kunlunxin", reason="Kunlunxin masked SDPA"
+)
+@pytest.mark.scaled_dot_product_efficient_attention
+@pytest.mark.parametrize("dtype", [torch.float16, torch.float32])
+@pytest.mark.parametrize("length", [17, 54])
+@pytest.mark.parametrize(
+    "mask_kind",
+    ["none", "padding", "strided", "shift", "fully_masked", "causal_bias", "bool"],
+)
+def test_masked_efficient_attention(dtype, length, mask_kind):
+    generator = torch.Generator(device="cpu").manual_seed(91)
+    shape = (2, 3, length, 32)
+    q, k, v = [torch.randn(shape, generator=generator).to(dtype) for _ in range(3)]
+    bias = None
+    if mask_kind != "none":
+        bias = torch.zeros((2, 1, length, length), dtype=dtype)
+        bias[..., -3:] = float("-inf")
+        if mask_kind == "strided":
+            backing = torch.zeros((2, 1, length, 2 * length), dtype=dtype)
+            backing[..., ::2] = bias
+            bias = backing[..., ::2]
+        elif mask_kind == "shift":
+            bias[..., :-3] = -20.0
+        elif mask_kind == "fully_masked":
+            bias[:, :, 3, :] = float("-inf")
+        elif mask_kind == "causal_bias":
+            bias[..., :-3] = torch.linspace(-1.0, 1.0, length - 3).to(dtype)
+        elif mask_kind == "bool":
+            bias = bias.isfinite()
+    causal = mask_kind == "causal_bias"
+    scores = q.double() @ k.double().transpose(-2, -1) / (32**0.5)
+    if bias is not None:
+        scores = (
+            scores.masked_fill(~bias, float("-inf"))
+            if bias.dtype == torch.bool
+            else scores + bias.double()
+        )
+    if causal:
+        allowed = torch.ones((length, length), dtype=torch.bool).tril()
+        scores = scores.masked_fill(~allowed, float("-inf"))
+    ref = scores.softmax(-1).nan_to_num(0.0) @ v.double()
+    lse_ref = torch.logsumexp(scores, dim=-1)
+    qd, kd, vd = [x.cuda() for x in (q, k, v)]
+    if mask_kind == "strided":
+        bd = backing.cuda()[..., ::2]
+        assert bd.stride(-1) == 2
+    else:
+        bd = bias.cuda() if bias is not None else None
+    with flag_gems.use_gems(exclude=[]):
+        out, lse, _, _ = torch.ops.aten._scaled_dot_product_efficient_attention.default(
+            qd, kd, vd, bd, True, 0.0, causal
+        )
+        torch.cuda.synchronize()
+    torch.testing.assert_close(out.cpu().double(), ref, atol=2e-3, rtol=5e-3)
+    torch.testing.assert_close(lse.cpu().double(), lse_ref, atol=2e-3, rtol=5e-3)
